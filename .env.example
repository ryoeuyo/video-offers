APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://postgres:postgres@localhost:5432/video_offers?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# В проде — минимум 32 байта случайных данных: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Rate limit по IP
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_OFFER_MAX=10
RATE_LIMIT_OFFER_WINDOW=1m

# CORS для фронтенда (через запятую). Пусто — CORS выключен.
CORS_ORIGINS=http://localhost:5173
